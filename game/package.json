  "version": "0.1.0",
  "private": true,
  "creator": { "version": "3.8.8" },
  "engines": { "node": ">=24.5.0 <25" },
  "scripts": {
    "config:export": "node tools/export-balance.mjs",
    "assets:sea": "python3 tools/prepare-sea-assets.py",
    "pretest": "node tools/export-balance.mjs --check && npm run build:shared",
    "build:shared": "tsc -p ../shared/tsconfig.json",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs ../shared/tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../shared/tsconfig.json",
    "build:web": "node tools/build-web.mjs web-debug",
    "build:web:release": "node tools/build-web.mjs web-release",
    "test:web": "node --test tests/web.smoke.mjs",
    "typecheck:battle": "tsc --noEmit -p tsconfig.battle.json",
    "test:battle:web": "node --test tests/battle-browser.mjs",
    "test:dive:web": "node --test tests/dive.smoke.mjs",
    "test:sonar:web": "node --test tests/sonar-ads.smoke.mjs",
    "test:economy:web": "node --test tests/economy.smoke.mjs",
    "typecheck:services": "tsc --noEmit -p tsconfig.services.json",
    "battle:serve": "node tools/battle-fixture-server.mjs",
    "test:harbor:web": "node --test tests/harbor.smoke.mjs",
    "test:sea:web": "node --test tests/sea-content.smoke.mjs",
    "test:tutorial:web": "node --test tests/tutorial.smoke.mjs",
    "test:quality:web": "node --test tests/quality.smoke.mjs",
    "test:perf:web": "node --test tests/perf-stress.smoke.mjs",
    "test:progression:web": "node --test tests/progression.smoke.mjs",
    "dev:serve": "node tools/dev-serve.mjs",
    "test:dev-entry:web": "node --test tests/dev-entry.smoke.mjs"
  },
  "dependencies": { "@abyss-hunter/shared": "file:../shared" },
  "devDependencies": { "playwright": "1.56.1", "typescript": "5.9.3" }
}
